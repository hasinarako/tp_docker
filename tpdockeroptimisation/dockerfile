FROM node:20 AS build
WORKDIR /app
COPY . /app
RUN npm install 
RUN npm run build && apt-get update && apt-get install -y build-essential ca-certificates locales
RUN echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && locale-gen

FROM node:20-slim
WORKDIR /app
COPY --from=build /app ./
EXPOSE 3000 4000 5000
ENV NODE_ENV=development
CMD ["node", "server.js"]